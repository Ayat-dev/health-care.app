<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.clinic.client.controller.DashboardController"
            prefWidth="980" prefHeight="640">

    <left>
        <VBox spacing="4" style="-fx-padding:20 12; -fx-background-color:#0f172a; -fx-pref-width:210px;">
            <Label text="⚕ ClinicApp" style="-fx-font-size:18px; -fx-font-weight:bold; -fx-text-fill:white; -fx-padding:0 0 4 0;"/>
            <Label text="Cockpit propriétaire" style="-fx-font-size:11px; -fx-text-fill:#64748b; -fx-padding:0 0 16 0;"/>
            <Button text="Tableau de bord" maxWidth="Infinity" style="-fx-background-color:#2563eb; -fx-text-fill:white; -fx-background-radius:6;"/>
            <Button text="Actualiser" maxWidth="Infinity" onAction="#refresh" style="-fx-background-color:transparent; -fx-text-fill:#94a3b8; -fx-cursor:hand; -fx-background-radius:6;"/>
            <Separator style="-fx-padding:8 0;"/>
            <Button text="Déconnexion" maxWidth="Infinity" onAction="#logout" style="-fx-background-color:#ef4444; -fx-text-fill:white; -fx-background-radius:6; -fx-cursor:hand;"/>
        </VBox>
    </left>

    <center>
        <ScrollPane fitToWidth="true" style="-fx-background-color:#f1f5f9;">
            <VBox spacing="20" style="-fx-padding:28; -fx-background-color:#f1f5f9;">
                <HBox spacing="12" alignment="CENTER_LEFT">
                    <Label fx:id="welcomeLabel" style="-fx-font-size:22px; -fx-font-weight:bold;"/>
                    <Label fx:id="roleLabel" style="-fx-background-color:#dcfce7; -fx-text-fill:#15803d; -fx-padding:3 10; -fx-background-radius:999; -fx-font-size:11px; -fx-font-weight:bold;"/>
                </HBox>

                <!-- ── Revenus ──────────────────────────────────────────────── -->
                <Label text="Revenus (encaissements)" style="-fx-font-weight:bold; -fx-font-size:14px; -fx-text-fill:#334155;"/>
                <HBox spacing="16">
                    <VBox spacing="6" HBox.hgrow="ALWAYS" style="-fx-background-color:white; -fx-padding:20; -fx-background-radius:10;">
                        <Label fx:id="revenueTodayValue" text="—" style="-fx-font-size:28px; -fx-font-weight:bold; -fx-text-fill:#16a34a;"/>
                        <Label text="Encaissé aujourd'hui" style="-fx-text-fill:#64748b; -fx-font-size:12px;"/>
                    </VBox>
                    <VBox spacing="6" HBox.hgrow="ALWAYS" style="-fx-background-color:white; -fx-padding:20; -fx-background-radius:10;">
                        <Label fx:id="revenueMonthValue" text="—" style="-fx-font-size:28px; -fx-font-weight:bold; -fx-text-fill:#2563eb;"/>
                        <Label text="Encaissé ce mois" style="-fx-text-fill:#64748b; -fx-font-size:12px;"/>
                        <Label fx:id="revenueVariationValue" text="" style="-fx-font-size:11px; -fx-font-weight:bold;"/>
                    </VBox>
                    <VBox spacing="6" HBox.hgrow="ALWAYS" style="-fx-background-color:white; -fx-padding:20; -fx-background-radius:10;">
                        <Label fx:id="outstandingValue" text="—" style="-fx-font-size:28px; -fx-font-weight:bold; -fx-text-fill:#d97706;"/>
                        <Label text="Reste à recouvrer (mois)" style="-fx-text-fill:#64748b; -fx-font-size:12px;"/>
                    </VBox>
                </HBox>

                <!-- ── Activité / occupation / stock ────────────────────────── -->
                <Label text="Activité &amp; exploitation" style="-fx-font-weight:bold; -fx-font-size:14px; -fx-text-fill:#334155;"/>
                <HBox spacing="16">
                    <VBox spacing="6" HBox.hgrow="ALWAYS" style="-fx-background-color:white; -fx-padding:20; -fx-background-radius:10;">
                        <Label fx:id="consultationsValue" text="—" style="-fx-font-size:28px; -fx-font-weight:bold; -fx-text-fill:#0f172a;"/>
                        <Label text="Consultations ce mois" style="-fx-text-fill:#64748b; -fx-font-size:12px;"/>
                    </VBox>
                    <VBox spacing="6" HBox.hgrow="ALWAYS" style="-fx-background-color:white; -fx-padding:20; -fx-background-radius:10;">
                        <Label fx:id="occupancyValue" text="—" style="-fx-font-size:28px; -fx-font-weight:bold; -fx-text-fill:#0f172a;"/>
                        <Label text="Occupation des lits" style="-fx-text-fill:#64748b; -fx-font-size:12px;"/>
                    </VBox>
                    <VBox spacing="6" HBox.hgrow="ALWAYS" style="-fx-background-color:white; -fx-padding:20; -fx-background-radius:10;">
                        <Label fx:id="stockAlertValue" text="—" style="-fx-font-size:28px; -fx-font-weight:bold; -fx-text-fill:#dc2626;"/>
                        <Label text="Alertes stock (bas / périmés)" style="-fx-text-fill:#64748b; -fx-font-size:12px;"/>
                    </VBox>
                </HBox>

                <!-- ── Modes de paiement ────────────────────────────────────── -->
                <VBox spacing="8" style="-fx-background-color:white; -fx-padding:20; -fx-background-radius:10;">
                    <Label text="Encaissements par mode de paiement (ce mois)" style="-fx-font-weight:bold; -fx-font-size:13px;"/>
                    <VBox fx:id="paymentBreakdownBox" spacing="4"/>
                </VBox>

                <Label fx:id="statusLabel" style="-fx-text-fill:#64748b; -fx-font-size:12px;"/>
            </VBox>
        </ScrollPane>
    </center>
</BorderPane>
