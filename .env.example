# ============================================================
#  ClinicApp — variables d'environnement (PRODUCTION)
#  Copier en .env puis remplir avec des valeurs FORTES :
#      cp .env.example .env && nano .env
#  Le fichier .env NE DOIT JAMAIS être committé (cf. .gitignore).
# ============================================================

# --- PostgreSQL (conteneur DB) ---
POSTGRES_USER=clinic_user
POSTGRES_PASSWORD=remplacer-par-un-mot-de-passe-fort
POSTGRES_DB=clinicdb

# --- TLS / Let's Encrypt (Z6 — HTTPS automatisé) ---
# Utilisés UNIQUEMENT avec le calque docker-compose.letsencrypt.yml + init-letsencrypt.sh.
# Sans eux, la stack reste sur le certificat auto-signé LAN (cf. nginx/README.md).
# DOMAIN : nom de domaine public dont le DNS pointe sur cet hôte (A/AAAA).
DOMAIN=clinique.example.com
# LETSENCRYPT_EMAIL : contact pour les avis d'expiration/sécurité de Let's Encrypt.
LETSENCRYPT_EMAIL=admin@example.com
# LETSENCRYPT_STAGING : 1 = environnement de test (quotas larges, certif NON fiable,
# à utiliser pour valider le flux) ; 0 = vraie émission (défaut).
LETSENCRYPT_STAGING=0

# --- Backend Spring (profil prod) ---
SPRING_PROFILES_ACTIVE=prod
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/clinicdb
SPRING_DATASOURCE_USERNAME=clinic_user
SPRING_DATASOURCE_PASSWORD=remplacer-par-un-mot-de-passe-fort

# Secret JWT : OBLIGATOIRE, minimum 32 caractères aléatoires.
# Générer p.ex. avec : openssl rand -base64 48
JWT_SECRET=remplacer-par-un-secret-aleatoire-de-32-caracteres-minimum
# P4.4 : access token COURT (défaut 15 min) + refresh token LONG (défaut 7 jours).
JWT_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=604800000
# D1a : cookie HttpOnly du refresh token (front web). Garder à true en prod (HTTPS) ;
# false uniquement en HTTP local sinon le navigateur n'émet jamais le cookie.
JWT_REFRESH_COOKIE_SECURE=true
# D1b : rétention (jours) des refresh tokens expirés/révoqués avant purge planifiée.
JWT_REFRESH_CLEANUP_RETENTION_DAYS=7
# D1d : rate-limit IP du login (Bucket4j) — N tentatives par IP et par fenêtre (minutes).
# Plus permissif que le lockout par compte car une clinique derrière un NAT partage une IP.
LOGIN_RATE_LIMIT_MAX=20
LOGIN_RATE_LIMIT_WINDOW_MINUTES=15

# Clé de chiffrement des données PHI au repos (P2.5) : OBLIGATOIRE.
# Sert à chiffrer les colonnes médicales sensibles (antécédents, allergies,
# adresse, notes…) via AES-256-GCM. Générer un secret aléatoire fort :
#     openssl rand -base64 48
# ⚠️  NE JAMAIS la changer après mise en service sans ré-chiffrer la base :
#     une clé différente rend les colonnes chiffrées illisibles.
APP_ENCRYPTION_KEY=remplacer-par-une-cle-aleatoire-forte

# Chiffrement des fichiers uploadés au repos (D3b) — photos patients, images radio, logo.
# Par défaut = APP_ENCRYPTION_KEY ; définir une clé dédiée pour découpler la rotation des
# fichiers de celle des colonnes PHI. Rotation : poser l'ancienne clé dans _PREVIOUS_KEY,
# promouvoir la nouvelle dans _KEY, appeler POST /api/admin/maintenance/rotate-file-encryption,
# puis retirer _PREVIOUS_KEY.
# APP_STORAGE_ENCRYPTION_KEY=remplacer-par-une-cle-dediee-forte
# APP_STORAGE_ENCRYPTION_PREVIOUS_KEY=

# Secret HMAC des webhooks Mobile Money (P3.3) : OBLIGATOIRE.
# Partagé avec l'agrégateur (Orange/Wave/MTN). Chaque notification est signée
# X-Webhook-Signature = hex(HMAC-SHA256(corps, secret)). Générer :
#     openssl rand -base64 32
MOBILE_MONEY_WEBHOOK_SECRET=remplacer-par-un-secret-aleatoire

# --- Scribe IA ambiant (P4.1) : transcription → note clinique structurée ---
# Désactivé par défaut. Activer uniquement si l'envoi du transcript de
# consultation (donnée de santé / PHI) au cloud Anthropic est couvert par un
# accord (BAA + Zero-Data-Retention). La clé API ne sert qu'à la structuration.
SCRIBE_ENABLED=false
SCRIBE_MODEL=claude-opus-4-8
ANTHROPIC_API_KEY=

# --- Compte administrateur initial (créé au 1er démarrage si base vide) ---
# Au moins l'un des deux blocs (admin de clinique OU super-admin) doit être fourni,
# sinon l'assistant web /setup prend le relais au premier accès.
CLINIC_ADMIN_USERNAME=admin
CLINIC_ADMIN_PASSWORD=remplacer-par-un-mot-de-passe-admin-fort

# --- Super-admin transverse (multi-tenant P4.2, optionnel) ---
# Gère le registre des cliniques (/admin/clinics) et provisionne les cliniques + leurs admins.
# clinic_id NULL (n'appartient à aucune clinique). Laisser vide pour ne pas en créer.
CLINIC_SUPERADMIN_USERNAME=
CLINIC_SUPERADMIN_PASSWORD=

# --- Stockage des fichiers (dans le conteneur, monté sur un volume) ---
APP_STORAGE_UPLOAD_DIR=/app/uploads

# --- Monitoring (P4.3) : Actuator + Prometheus/Grafana, UptimeRobot ---
# /actuator/health et /actuator/info sont PUBLICS (sondes UptimeRobot / LB).
# /actuator/prometheus et /actuator/metrics sont protégés par ces identifiants
# HTTP Basic (compte de scraping dédié, indépendant des comptes métier).
# OBLIGATOIRE en prod (le mot de passe n'a pas de défaut → fail-fast au démarrage).
# Reporter ces mêmes valeurs dans monitoring/prometheus.yml (basic_auth).
MONITORING_USERNAME=monitor
MONITORING_PASSWORD=remplacer-par-un-secret-de-scraping-fort

# Console Grafana — uniquement avec le profil compose « monitoring »
# (docker compose --profile monitoring up). Exposée sur le port 3000.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=remplacer-par-un-mot-de-passe-grafana-fort

# ── Notifications sortantes (SMS / e-mail) ───────────────────────────────────
# TOUT est OPTIONNEL. Si rien n'est configuré, les notifications sont simulées
# (loggées) — l'app fonctionne, mais les rappels RDV / résultats / relances ne
# partent PAS réellement. Renseigner l'un OU l'autre (ou les deux) pour activer.
#
# E-mail (SMTP) : dès que SPRING_MAIL_HOST est défini, l'émetteur e-mail s'active.
#SPRING_MAIL_HOST=smtp.exemple.com
#SPRING_MAIL_PORT=587
#SPRING_MAIL_USERNAME=notifications@clinique.example
#SPRING_MAIL_PASSWORD=remplacer-par-le-mot-de-passe-smtp
#SPRING_MAIL_PROPERTIES_MAIL_SMTP_AUTH=true
#SPRING_MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_ENABLE=true
#APP_MAIL_FROM=Clinique <notifications@clinique.example>
#
# SMS (Africa's Talking) : dès qu'une clé API est fournie, l'émetteur SMS s'active.
#APP_SMS_AFRICASTALKING_API_KEY=remplacer-par-la-cle-api
#APP_SMS_AFRICASTALKING_USERNAME=sandbox
#APP_SMS_AFRICASTALKING_SENDER_ID=CLINIQUE
#APP_SMS_AFRICASTALKING_BASE_URL=https://api.africastalking.com

# ── Accès patient à distance — Cloudflare Tunnel (profil compose « remote ») ──
# Optionnel. Permet aux patients d'accéder au portail depuis chez eux sans ouvrir
# de port sur la box. Créer un tunnel sur https://one.dash.cloudflare.com (Zero
# Trust → Networks → Tunnels), router le hostname public → http://backend:8080,
# puis coller ici le token du tunnel. Démarrage : docker compose --profile remote up -d
#CLOUDFLARE_TUNNEL_TOKEN=coller-le-token-du-tunnel-cloudflare

# ── Sauvegardes automatiques PostgreSQL (service db-backup) ───────────────────
# Planification cron (défaut : tous les jours à 02:00) et rétention par âge.
# Les dumps sont écrits dans ./backups sur l'hôte — À COPIER HORS-SITE.
BACKUP_SCHEDULE=0 2 * * *
BACKUP_KEEP_DAYS=30
BACKUP_KEEP_WEEKS=8
BACKUP_KEEP_MONTHS=12
